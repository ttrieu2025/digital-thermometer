033F             62   ; Initialize MCU, timers, UART, ADC, pins
033F             63   ;-----------------------------
033F             64   Init_All:
033F             65       ; Configure all GPIO pins as bidirectional
033F 75AC00      66       MOV P3M1,#0x00
0342 75AD00      67       MOV P3M2,#0x00
0345 75B300      68       MOV P1M1,#0x00
0348 75B400      69       MOV P1M2,#0x00
034B 75B100      70       MOV P0M1,#0x00
034E 75B200      71       MOV P0M2,#0x00
0351             72   
0351             73       ; UART init
0351 438E10      74       ORL CKCON,#0x10
0354 438780      75       ORL PCON,#0x80  ; SMOD=1 double baud
0357 759852      76       MOV SCON,#0x52
035A 53C4DF      77       ANL T3CON,#0b11011111
035D 53890F      78       ANL TMOD,#0x0F
0360 438920      79       ORL TMOD,#0x20   ; Timer1 mode 2
0363 758DF7      80       MOV TH1,#TIMER1_RELOAD
0366 D28E        81       SETB TR1
0368             82   
0368             83       ; Timer0 for delay
0368 C28C        84       CLR TR0
036A 438E08      85       ORL CKCON,#0x08
036D 5389F0      86       ANL TMOD,#0xF0
0370 438901      87       ORL TMOD,#0x01   ; Timer0 mode1 16-bit
0373             88   
0373             89       ; ADC pin P1.1 input
0373 43B302      90       ORL P1M1,#0b00000010
0376 53B4FD      91       ANL P1M2,#0b11111101
0379             92   
0379             93       ; ADC init
0379 53E8F0      94       ANL ADCCON0,#0xF0
