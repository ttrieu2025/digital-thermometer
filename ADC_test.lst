03A7            132   ; Send temperature via UART: Fits Display_formated_BCD
03A7            133   ; Expected format on LCD: [bcd+2].[bcd+1][bcd+0]
03A7            134   ;-----------------------------
03A7            135   
03A7            136   Send_Temp_Serial:
03A7            137       ; 1. Send Whole Number Part (from bcd+2)
03A7            138       ; Assuming bcd+2 has Tens in high nibble and Ones in low nibble
03A7            139       ; Or just a single digit. Let's send both nibbles:
03A7 E53A       140       mov a, bcd+2
03A9 C4         141       swap a
03AA 540F       142       anl a, #0x0F
03AC 4430       143       orl a, #0x30    ; Convert to ASCII
03AE 12039F     144       lcall putchar
03B1            145       
03B1 E53A       146       mov a, bcd+2
03B3 540F       147       anl a, #0x0F
03B5 4430       148       orl a, #0x30
03B7 12039F     149       lcall putchar
03BA            150   
03BA            151       ; 2. Send Decimal Point
03BA 742E       152       mov a, #'.'
03BC 12039F     153       lcall putchar
03BF            154   
03BF            155       ; 3. Send Fractional Part (from bcd+1 and bcd+0)
03BF            156       ; To keep Python happy, we send the digits immediately after the dot
03BF E539       157       mov a, bcd+1
03C1 C4         158       swap a
03C2 540F       159       anl a, #0x0F
03C4 4430       160       orl a, #0x30
03C6 12039F     161       lcall putchar
03C9            162       
03C9 E539       163       mov a, bcd+1
03CB 540F       164       anl a, #0x0F
03CD 4430       165       orl a, #0x30
03CF 12039F     166       lcall putchar
03D2            167   
03D2 7420       168       mov a, #' '
03D4 12039F     169       lcall putchar
03D7 200104     170       jb isF, SendF_Serial
03DA 7443       171       mov a, #'C'
03DC 8002       172       sjmp Send_LineEnd
03DE            173   SendF_Serial:
03DE 7446       174       mov a, #'F'
03E0            175   
03E0            176   Send_LineEnd:
03E0 12039F     177       lcall putchar
03E3            178   
03E3            179       ; 5. End of Line (CR + LF)
03E3 740D       180       mov a, #0x0D
03E5 12039F     181       lcall putchar
03E8 740A       182       mov a, #0x0A
03EA 12039F     183       lcall putchar
03ED 22         184       ret
