0389            102   ;-----------------------------
0389            103   ; 1ms wait using Timer0
0389            104   ;-----------------------------
0389            105   wait_1ms:
0389 C28C       106       CLR TR0
038B C28D       107       CLR TF0
038D 758CBF     108       MOV TH0,#HIGH(TIMER0_RELOAD_1MS)
0390 758A28     109       MOV TL0,#LOW(TIMER0_RELOAD_1MS)
0393 D28C       110       SETB TR0
0395 308DFD     111       JNB TF0,$
0398 22         112       RET
