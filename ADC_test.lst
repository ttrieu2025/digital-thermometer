040A C000       190            push ar0
040C A839       190            mov r0, bcd+1
040E 1200B9     190            lcall ?Display_BCD
0411 D000       190            pop ar0
0413 C000       191            push ar0
0415 A838       191            mov r0, bcd+0
0417 1200B9     191            lcall ?Display_BCD
041A D000       191            pop ar0
