0000             22   CLK               EQU 16600000       ; MCU frequency in Hz
0000             23   BAUD              EQU 115200         ; UART baud rate
0000             24   TIMER1_RELOAD     EQU (0x100-(CLK/(16*BAUD)))
0000             25   TIMER0_RELOAD_1MS EQU (0x10000-(CLK/1000))
